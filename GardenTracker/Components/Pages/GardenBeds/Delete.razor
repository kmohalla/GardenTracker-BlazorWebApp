@page "/gardenbeds/delete/{id:int}"
@rendermode InteractiveServer
@using GardenData
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GardenContext> ContextFactory
@inject NavigationManager Navigation

<PageTitle>Delete GardenBed</PageTitle>

<h1>Delete GardenBed</h1>

@if (!string.IsNullOrEmpty(loadError))
{
	<div class="alert alert-danger" role="alert">@loadError</div>
}
else if (gardenBed is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<h3>Are you sure you want to delete this?</h3>
	<dl class="row">
		<dt class="col-sm-2">Name</dt>
		<dd class="col-sm-10">@gardenBed.Name</dd>

		<dt class="col-sm-2">Status</dt>
		<dd class="col-sm-10">@gardenBed.Status</dd>

		<dt class="col-sm-2">Planted Date</dt>
		<dd class="col-sm-10">@gardenBed.PlantedDate</dd>

		<dt class="col-sm-2">Guide</dt>
		<dd class="col-sm-10">@gardenBed.Guide?.Name</dd>

		<dt class="col-sm-2">Plant</dt>
		<dd class="col-sm-10">@gardenBed.Plant?.Name</dd>

		<dt class="col-sm-2">Tool</dt>
		<dd class="col-sm-10">@gardenBed.Tool?.Type</dd>
	</dl>

	@if (!string.IsNullOrEmpty(deleteError))
	{
		<div class="alert alert-danger" role="alert">@deleteError</div>
	}

	<button class="btn btn-danger" @onclick="DeleteAsync">Delete</button>
	<a class="btn btn-secondary ms-2" href="/gardenbeds">Back to list</a>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private GardenBed? gardenBed;
	private string? loadError;
	private string? deleteError;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			var gardenBeds = await context.GetAllGardenBedsAsync();
			gardenBed = gardenBeds.FirstOrDefault(p => p.Id == Id);

			if (gardenBed is null)
			{
				loadError = $"GardenBed with Id {Id} was not found.";
			}
		}
		catch (Exception ex)
		{
			loadError = $"Unable to load garden bed: {ex.Message}";
		}
	}

	private async Task DeleteAsync()
	{
		deleteError = null;

		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			await context.DeleteGardenBedAsync(Id);
			Navigation.NavigateTo("/gardenbeds");
		}
		catch (Exception ex)
		{
			deleteError = $"Unable to delete garden bed: {ex.Message}";
		}
	}
}
