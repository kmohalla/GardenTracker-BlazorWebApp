@page "/tools/edit/{id:int}"
@rendermode InteractiveServer //setting render mode interactive explicitly allows the button clicks to work, eventhough this is the default for blazor apps
@using GardenData
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GardenContext> ContextFactory
@inject NavigationManager Navigation

<PageTitle>Edit Tool</PageTitle>

<h1>Edit Tool</h1>

@if (!string.IsNullOrEmpty(loadError))
{
	<div class="alert alert-danger" role="alert">@loadError</div>
}
else if (tool is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<EditForm Model="tool" FormName="EditToolForm" OnValidSubmit="SaveAsync">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div class="mb-3">
			<label for="type" class="form-label">Type</label>
			<InputText id="type" class="form-control" @bind-Value="tool.Type" />
		</div>

		<div class="mb-3">
			<label for="material" class="form-label">Material</label>
			<InputText id="material" class="form-control" @bind-Value="tool.Material" />
		</div>

		<div class="mb-3">
			<label for="length" class="form-label">Length (cm)</label>
			<InputNumber id="length" class="form-control" @bind-Value="tool.LengthCm" />
		</div>

		<div class="mb-3">
			<label for="weight" class="form-label">Weight (kg)</label>
			<InputNumber id="weight" class="form-control" @bind-Value="tool.WeightKg" />
		</div>

		@if (!string.IsNullOrEmpty(saveError))
		{
			<div class="alert alert-danger" role="alert">@saveError</div>
		}

		<a class="btn btn-danger" href="@($"/tools/delete/{tool.Id}")">Delete</a>
		<button type="submit" class="btn btn-primary">Save</button>
		<a class="btn btn-secondary ms-2" href="/tools">Back to list</a>
	</EditForm>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private Tool? tool;
	private string? loadError;
	private string? saveError;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			tool = await context.GetToolByIdAsync(Id);

			if (tool is null)
			{
				loadError = $"Tool with Id {Id} was not found.";
			}
		}
		catch (Exception ex)
		{
			loadError = $"Unable to load tool: {ex.Message}";
		}
	}

	private async Task SaveAsync()
	{
		if (tool is null)
		{
			return;
		}

		saveError = null;

		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			await context.UpdateToolAsync(tool);
			Console.WriteLine($"Tool {tool.Id} saved successfully");
			Navigation.NavigateTo("/tools");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Save error: {ex.Message}");
			saveError = $"Unable to save changes: {ex.Message}";
		}
	}
}
