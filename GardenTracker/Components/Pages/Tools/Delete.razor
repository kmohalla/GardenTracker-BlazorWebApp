@page "/tools/delete/{id:int}"
@rendermode InteractiveServer
@using GardenData
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GardenContext> ContextFactory
@inject NavigationManager Navigation

<PageTitle>Delete Tool</PageTitle>

<h1>Delete Tool</h1>

@if (!string.IsNullOrEmpty(loadError))
{
	<div class="alert alert-danger" role="alert">@loadError</div>
}
else if (tool is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<h3>Are you sure you want to delete this?</h3>
	<dl class="row">
		<dt class="col-sm-2">Type</dt>
		<dd class="col-sm-10">@tool.Type</dd>

		<dt class="col-sm-2">Material</dt>
		<dd class="col-sm-10">@tool.Material</dd>

		<dt class="col-sm-2">Length (cm)</dt>
		<dd class="col-sm-10">@tool.LengthCm</dd>

		<dt class="col-sm-2">Weight (kg)</dt>
		<dd class="col-sm-10">@tool.WeightKg</dd>
	</dl>

	@if (!string.IsNullOrEmpty(deleteError))
	{
		<div class="alert alert-danger" role="alert">@deleteError</div>
	}

	<button class="btn btn-danger" @onclick="DeleteAsync">Delete</button>
	<a class="btn btn-secondary ms-2" href="/tools">Back to list</a>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private Tool? tool;
	private string? loadError;
	private string? deleteError;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			tool = await context.GetToolByIdAsync(Id);

			if (tool is null)
			{
				loadError = $"Tool with Id {Id} was not found.";
			}
		}
		catch (Exception ex)
		{
			loadError = $"Unable to load tool: {ex.Message}";
		}
	}

	private async Task DeleteAsync()
	{
		deleteError = null;

		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			await context.DeleteToolAsync(Id);
			Navigation.NavigateTo("/tools");
		}
		catch (Exception ex)
		{
			deleteError = $"Unable to delete tool: {ex.Message}";
		}
	}
}