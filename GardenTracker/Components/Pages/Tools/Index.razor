@page "/tools"
@using GardenData
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GardenContext> ContextFactory

<PageTitle>Tools</PageTitle>

<h1>Tools</h1>

<a href="/tools/create">Create Tool</a>

@if (!string.IsNullOrEmpty(loadError))
{
	<div class="alert alert-danger" role="alert">@loadError</div>
}
else if (tools is null)
{
	<p><em>Loading...</em></p>
}
else if (tools.Count == 0)
{
	<p>No tools found.</p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Type</th>
				<th>Material</th>
				<th>Length (cm)</th>
				<th>Weight (kg)</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in tools)
			{
				<tr>
					<td>@item.Id</td>
					<td>@item.Type</td>
					<td>@item.Material</td>
					<td>@item.LengthCm</td>
					<td>@item.WeightKg</td>
					<td>
						<a href="@($"/tools/edit/{item.Id}")">Edit</a> |
						<a href="@($"/tools/delete/{item.Id}")">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	private List<Tool>? tools;
	private string? loadError;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			tools = await context.GetAllToolsAsync();
		}
		catch (Exception ex)
		{
			loadError = $"Unable to load tools: {ex.Message}";
		}
	}
}
