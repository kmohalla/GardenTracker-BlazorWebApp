@page "/plants/delete/{id:int}"
@rendermode InteractiveServer
@using GardenData
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GardenContext> ContextFactory
@inject NavigationManager Navigation

<PageTitle>Delete Plant</PageTitle>

<h1>Delete Plant</h1>

@if (!string.IsNullOrEmpty(loadError))
{
	<div class="alert alert-danger" role="alert">@loadError</div>
}
else if (plant is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<h3>Are you sure you want to delete this?</h3>
	<dl class="row">
		<dt class="col-sm-2">Name</dt>
		<dd class="col-sm-10">@plant.Name</dd>

		<dt class="col-sm-2">Family</dt>
		<dd class="col-sm-10">@plant.Family</dd>

		<dt class="col-sm-2">Type</dt>
		<dd class="col-sm-10">@plant.Type</dd>

		<dt class="col-sm-2">Color</dt>
		<dd class="col-sm-10">@plant.Color</dd>

		<dt class="col-sm-2">Supplier</dt>
		<dd class="col-sm-10">@plant.Supplier?.Name</dd>
	</dl>

	@if (!string.IsNullOrEmpty(deleteError))
	{
		<div class="alert alert-danger" role="alert">@deleteError</div>
	}

	<button class="btn btn-danger" @onclick="DeleteAsync">Delete</button>
	<a class="btn btn-secondary ms-2" href="/plants">Back to list</a>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private Plant? plant;
	private string? loadError;
	private string? deleteError;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			var plants = await context.GetAllPlantsAsync();
			plant = plants.FirstOrDefault(p => p.Id == Id);

			if (plant is null)
			{
				loadError = $"Plant with Id {Id} was not found.";
			}
		}
		catch (Exception ex)
		{
			loadError = $"Unable to load plant: {ex.Message}";
		}
	}

	private async Task DeleteAsync()
	{
		deleteError = null;

		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			await context.DeletePlantAsync(Id);
			Navigation.NavigateTo("/plants");
		}
		catch (Exception ex)
		{
			deleteError = $"Unable to delete plant: {ex.Message}";
		}
	}
}
