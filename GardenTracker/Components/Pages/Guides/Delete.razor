@page "/guides/delete/{id:int}"
@rendermode InteractiveServer
@using GardenData
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GardenContext> ContextFactory
@inject NavigationManager Navigation

<PageTitle>Delete Guide</PageTitle>

<h1>Delete Guide</h1>

@if (!string.IsNullOrEmpty(loadError))
{
	<div class="alert alert-danger" role="alert">@loadError</div>
}
else if (guide is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<h3>Are you sure you want to delete this?</h3>
	<dl class="row">
		<dt class="col-sm-2">Name</dt>
		<dd class="col-sm-10">@guide.Name</dd>

		<dt class="col-sm-2">Author</dt>
		<dd class="col-sm-10">@guide.Author</dd>

		<dt class="col-sm-2">Season</dt>
		<dd class="col-sm-10">@guide.Season</dd>

		<dt class="col-sm-2">Difficulty</dt>
		<dd class="col-sm-10">@guide.Difficulty</dd>
	</dl>

	@if (!string.IsNullOrEmpty(deleteError))
	{
		<div class="alert alert-danger" role="alert">@deleteError</div>
	}

	<button class="btn btn-danger" @onclick="DeleteAsync">Delete</button>
	<a class="btn btn-secondary ms-2" href="/guides">Back to list</a>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private Guide? guide;
	private string? loadError;
	private string? deleteError;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			guide = await context.GetGuideByIdAsync(Id);

			if (guide is null)
			{
				loadError = $"Guide with Id {Id} was not found.";
			}
		}
		catch (Exception ex)
		{
			loadError = $"Unable to load guide: {ex.Message}";
		}
	}

	private async Task DeleteAsync()
	{
		deleteError = null;

		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			await context.DeleteGuideAsync(Id);
			Navigation.NavigateTo("/guides");
		}
		catch (Exception ex)
		{
			deleteError = $"Unable to delete guide: {ex.Message}";
		}
	}
}
