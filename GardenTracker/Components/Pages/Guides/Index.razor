@page "/guides"
@using GardenData
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GardenContext> ContextFactory

<PageTitle>Guides</PageTitle>

<h1>Guides</h1>

<a href="/guides/create">Create Guide</a>

@if (!string.IsNullOrEmpty(loadError))
{
	<div class="alert alert-danger" role="alert">@loadError</div>
}
else if (guides is null)
{
	<p><em>Loading...</em></p>
}
else if (guides.Count == 0)
{
	<p>No guides found.</p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>Author</th>
				<th>Season</th>
				<th>Difficulty</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in guides)
			{
				<tr>
					<td>@item.Id</td>
					<td>@item.Name</td>
					<td>@item.Author</td>
					<td>@item.Season</td>
					<td>@item.Difficulty</td>
					<td>
						<a href="@($"/guides/edit/{item.Id}")">Edit</a> |
						<a href="@($"/guides/delete/{item.Id}")">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	private List<Guide>? guides;
	private string? loadError;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await using var context = await ContextFactory.CreateDbContextAsync();
			guides = await context.GetAllGuidesAsync();
		}
		catch (Exception ex)
		{
			loadError = $"Unable to load guides: {ex.Message}";
		}
	}
}
